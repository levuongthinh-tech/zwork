# Sao chép thành .env và điền giá trị. KHÔNG commit tệp .env.
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
APP_BASE_URL=https://ten-mien-cua-ban.vn
SESSION_COOKIE_SECURE=1

# Railway Volume (ví dụ mount tại /data)
DATABASE_URL=sqlite:////data/zhipat_work.db
UPLOAD_FOLDER=/data/uploads

# Tài khoản quản trị tạo khi chạy `flask seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram bot (tạo qua @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=chuoi-ngau-nhien-chi-gom-chu-so-va-gach-duoi

# Hạn mức Trưởng phòng được duyệt ngân sách (VNĐ)
BUDGET_LIMIT_MANAGER=10000000
